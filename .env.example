# Deployed backend (default the client falls back to if this is unset)
VITE_MACROPAGE_CONNECT_API_URL=https://macropage-admin.onrender.com/api

# Local backend — uncomment to point at a backend running on your machine
# VITE_MACROPAGE_CONNECT_API_URL=http://localhost:3000/api

# Drives the "Production"/"Development" indicator shown in the UI.
# .env.production sets this to "production" automatically for `vite build`.
VITE_APP_ENV=development
